{
  "name": "gigshield",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Parametric Insurance for Q-Commerce Delivery Workers",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "migrate": "npm run migrate --workspace=packages/backend",
    "migrate:rollback": "npm run migrate:rollback --workspace=packages/backend",
    "seed": "npm run seed --workspace=packages/backend",
    "db:setup": "npm run migrate && npm run seed"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
